# npm start prepara um PostgreSQL local e gera .env se ele ainda não existir.
# Para usar um PostgreSQL já instalado, copie este arquivo para .env e ajuste:
DATABASE_URL=postgresql+psycopg://cantina:SUBSTITUA_A_SENHA@127.0.0.1:55432/cantina_em_dia
CANTINA_MANAGED_POSTGRES=0
API_PORT=8000
WEB_PORT=5173

