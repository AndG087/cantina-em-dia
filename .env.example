# npm run setup cria o .env automaticamente (pede a senha do root do MySQL).
# Para configurar à mão, copie este arquivo para .env e ajuste a senha do usuário cantina:
DATABASE_URL=mysql+pymysql://cantina:SUBSTITUA_A_SENHA@127.0.0.1:3306/cantina_em_dia
API_PORT=8000
WEB_PORT=5173
# Cópia de segurança diária na inicialização. Use 0 para desativar.
CANTINA_AUTO_BACKUP=1
# Opcional: pasta das cópias (padrão: %LOCALAPPDATA%\CantinaEmDia).
# CANTINA_DATA_DIR=C:/CantinaEmDia
